[configuration]

entry_symbol = "scaffolder_extension_init"
compatibility_minimum = "4.4"
reloadable = true

[libraries]

macos.debug = "res://addons/scaffolder/bin/macos/macos.framework/Scaffolder.macos.template_debug"
macos.release = "res://addons/scaffolder/bin/macos/macos.framework/Scaffolder.macos.template_release"
ios.debug = "res://addons/scaffolder/bin/ios/ios.framework/Scaffolder.ios.template_debug"
ios.release = "res://addons/scaffolder/bin/ios/ios.framework/Scaffolder.ios.template_release"
windows.debug.x86_32 = "res://addons/scaffolder/bin/windows/Scaffolder.windows.template_debug.x86_32.dll"
windows.release.x86_32 = "res://addons/scaffolder/bin/windows/Scaffolder.windows.template_release.x86_32.dll"
windows.debug.x86_64 = "res://addons/scaffolder/bin/windows/Scaffolder.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/scaffolder/bin/windows/Scaffolder.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://addons/scaffolder/bin/linux/Scaffolder.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/scaffolder/bin/linux/Scaffolder.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://addons/scaffolder/bin/linux/Scaffolder.linux.template_debug.arm64.so"
linux.release.arm64 = "res://addons/scaffolder/bin/linux/Scaffolder.linux.template_release.arm64.so"
linux.debug.rv64 = "res://addons/scaffolder/bin/linux/Scaffolder.linux.template_debug.rv64.so"
linux.release.rv64 = "res://addons/scaffolder/bin/linux/Scaffolder.linux.template_release.rv64.so"
android.debug.x86_64 = "res://addons/scaffolder/bin/android/Scaffolder.android.template_debug.x86_64.so"
android.release.x86_64 = "res://addons/scaffolder/bin/android/Scaffolder.android.template_release.x86_64.so"
android.debug.arm64 = "res://addons/scaffolder/bin/android/Scaffolder.android.template_debug.arm64.so"
android.release.arm64 = "res://addons/scaffolder/bin/android/Scaffolder.android.template_release.arm64.so"

[icons]

; FIXME
; TODO: Add other icons.
GDExample = "res://addons/scaffolder/addons/scaffolder/assets/editor_icons/ScaffolderNode.svg"
